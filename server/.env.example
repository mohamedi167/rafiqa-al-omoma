# انسخي هذا الملف إلى .env ثم املئي القيم بنفسك.
# لا تضعي أي مفاتيح أو كلمات مرور حقيقية داخل ملفات المشروع أو الـ git.

# --- البيئة ---
NODE_ENV=development
PORT=3000
DB_PATH=
# تفعيل البيانات التجريبية في الإنتاج (غير مفضّل: تنشئ حسابات بكلمات مرور معروفة).
SEED_DEMO=false

# --- مزوّد الذكاء الاصطناعي (اختياري) ---
# لو تركتيها فاضية، التطبيق شغّال بمحرّك ذكي محلي + موسوعة طبية واسعة.
USER_LLM_API_KEY=
USER_LLM_PROVIDER=
USER_LLM_BASE_URL=
USER_LLM_MODEL=

# إعدادات متوافقة مع الإصدار السابق (Anthropic مباشرة)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- المصادقة والجلسات (إلزامي في الإنتاج) ---
# قيمة عشوائية قوية لا تقل عن 32 حرفًا. مثال للتوليد: openssl rand -hex 32
JWT_SECRET=change-me-with-a-long-random-secret-32chars-min
JWT_TTL=7d

# --- CORS ---
# قائمة النطاقات المسموح بها مفصولة بفواصل. اتركيها فاضية للسماح بالمعاينة المحلية فقط.
CORS_ORIGINS=

# --- HTTPS / Proxy ---
# مسارات شهادة SSL في الإنتاج (اتركيها فاضية للتطوير عبر HTTP).
SSL_KEY_PATH=
SSL_CERT_PATH=
# إعادة توجيه كل الطلبات إلى HTTPS عند true (يتطلب شهادة).
FORCE_HTTPS=false
# فعّليه عند التشغيل خلف reverse proxy موثوق (Nginx/Traefik) لقراءة IP العميل.
TRUST_PROXY=false

# --- كلمات المرور ---
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# --- CAPTCHA (تحقق الأمان) ---
# مفعّل تلقائيًا في الإنتاج. اجعليه false لتعطيله في التطوير/الاختبارات فقط.
CAPTCHA_ENABLED=

# --- Rate limiting ---
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_MAX_FAILURES=5
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_SENSITIVE_MAX=60

# --- السجلات وحجم الطلب ---
LOG_LEVEL=info
LOG_DIR=
BODY_LIMIT=256kb
MAX_TEXT_LENGTH=5000
